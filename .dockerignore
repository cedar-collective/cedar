# RStudio and system files
.Rhistory
.Rdata
.Rproj.user
.DS_Store

# Host libraries/caches must never enter a Linux image.
renv/*
!renv/activate.R
!renv/settings.json

# Git and editor files
.git
.gitignore
.gitattributes
*.swp
*.swo
.idea/
.vscode/

# Git ignore rules do not protect Docker build contexts.
.env
.env.*
!.env.example
.Renviron
.Rapp.history
tests/e2e/node_modules/

# Data and output
data/
output/
app_cache/
