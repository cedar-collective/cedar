FROM --platform=linux/amd64 rocker/shiny:4.4.2

RUN apt-get update && apt-get install -y \
  git \
  libcurl4-openssl-dev \
  libssl-dev \
  libxml2-dev \
  xlsx2csv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/shiny-server/cedar

# Install packages not pre-installed in rocker/shiny.
# No renv in Docker — Docker provides the reproducibility layer.
# rocker/shiny already includes: shiny, bslib, htmltools, htmlwidgets,
# jsonlite, yaml, tidyverse (dplyr, lubridate, readxl, stringr, etc.)
RUN R -e "install.packages(c('tidyverse', 'plotly', 'DT', 'qs', 'data.table', 'optparse', 'fs', 'digest', 'rvest', 'pacman'))"

COPY . .
COPY shiny-server.conf /etc/shiny-server/shiny-server.conf

RUN chown -R shiny:shiny /srv/shiny-server/cedar
RUN mkdir -p /srv/shiny-server/cedar/data

EXPOSE 3838
USER shiny
