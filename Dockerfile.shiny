FROM rocker/shiny:4.4.2

RUN apt-get update && apt-get install -y \
  git \
  nodejs \
  libcurl4-openssl-dev \
  libssl-dev \
  libxml2-dev \
  xlsx2csv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/shiny-server/cedar

# Install packages not pre-installed in rocker/shiny.
# No renv in Docker — Docker provides the reproducibility layer.
# rocker/shiny already includes: shiny, bslib, htmltools, htmlwidgets,
# jsonlite, yaml, tidyverse (dplyr, lubridate, readxl, stringr, etc.)
RUN R -e "install.packages(c('tidyverse', 'plotly', 'DT', 'reactable', 'qs2', 'data.table', 'optparse', 'fs', 'digest', 'rvest', 'pacman'))"

# The rocker base's package snapshot ships qs2 0.1.4. Upgrade its compiled
# dependency chain from a coherent dated snapshot, then verify the required qs2.
RUN R -e "install.packages(c('RcppParallel', 'stringfish', 'qs2'), repos='https://packagemanager.posit.co/cran/2026-06-05'); stopifnot(packageVersion('qs2') >= package_version('0.2.2'))"

# testthat and Node are exercised by the CI test gate, which runs the canonical
# root test script inside this image. Baking them in keeps that step off the
# network and tests the same source tree production will run.
RUN R -e "install.packages('testthat')"

# Force a UTF-8 locale for ALL R processes. Placed AFTER the install layers so it
# doesn't invalidate the (expensive) package-install cache. shiny-server otherwise
# spawns its R worker in the C/US-ASCII locale, making qs2 emit "translating to
# UTF-8" warnings when reading strings with non-ASCII bytes (e.g. a non-breaking
# space). LC_ALL overrides LANG and is honored by R at startup.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 CEDAR_LOG_LEVEL=INFO

COPY . .
COPY shiny-server.conf /etc/shiny-server/shiny-server.conf

RUN chown -R shiny:shiny /srv/shiny-server/cedar
RUN mkdir -p /srv/shiny-server/cedar/data

RUN chmod +x /srv/shiny-server/cedar/entrypoint.sh

EXPOSE 3838
USER shiny
ENTRYPOINT ["/srv/shiny-server/cedar/entrypoint.sh"]
