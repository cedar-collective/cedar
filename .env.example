# Copy this file to .env and set the path for your machine.
#
# Local macOS example:
# CEDAR_DATA_DIR=/Users/yourname/path/to/shared-data
#
# Droplet example:
# CEDAR_DATA_DIR=/root/shared-data

CEDAR_DATA_DIR=/Users/absolute/path/to/shared-data

# Optional: copy production's prepared tables here with
# scripts/pull-production-data.sh (see scripts/README.md). Never commit these.
# CEDAR_PROD_SSH=yourlogin@production-host
# CEDAR_PROD_DATA_DIR=/root/shared-data
# CEDAR_PROD_OUTPUT_DIR=/root/cedar/output
# CEDAR_PROD_SSH_PORT=22
# CEDAR_PROD_SSH_KEY=~/.ssh/id_ed25519
