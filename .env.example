# Copy this file to .env and set the path for your machine.
#
# Local macOS example:
# CEDAR_DATA_DIR=/Users/yourname/path/to/shared-data
#
# Droplet example:
# CEDAR_DATA_DIR=/root/shared-data

CEDAR_DATA_DIR=/Users/absolute/path/to/shared-data

# The password that unlocks instructor-level results (names beside outcomes).
# docker-compose.yml passes it to the app; unset, those results stay closed.
# CEDAR_DFW_PASSWORD=choose-a-password

# How many of the most-analysed courses have Course Dynamics > Downstream built
# ahead when the app starts (10 when unset). Each is about 40 seconds of the
# app's one R process, in the background. 0 builds none: the setting for a
# development machine, where a restart should be ready at once.
# CEDAR_PRELOAD_COURSES=0

# Optional: copy production's prepared tables here with
# scripts/pull-production-data.sh (see scripts/README.md). Never commit these.
# CEDAR_PROD_SSH=yourlogin@production-host
# CEDAR_PROD_DATA_DIR=/root/shared-data
# CEDAR_PROD_OUTPUT_DIR=/root/cedar/output
# CEDAR_PROD_SSH_PORT=22
# CEDAR_PROD_SSH_KEY=~/.ssh/id_ed25519
